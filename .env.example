# Root environment configuration for Project ALENA

# --- Inference (LM Studio) -------------------------------------------------
# Any OpenAI-compatible server. LM Studio's default port is 1234; point this at
# a tailnet name to use a model running on another machine.
LLM_BASE_URL=http://localhost:1234
# Blank uses whichever model LM Studio currently has loaded, which is usually
# what you want -- the model is chosen in the LM Studio UI, not here.
LLM_MODEL=
LLM_TIMEOUT=120
# Set to 1 to log every raw model response.
LLM_DEBUG=0

# --- Speech-to-text (text-whisperer) ---------------------------------------
# Audio is transcribed by text-whisperer on the Mac that has the GPU. Nothing
# in this repo loads a Whisper model any more.
# NOTE: the /api/transcribe endpoint has to be added to text-whisperer first --
# see Documents/TEXT_WHISPERER_CONTRACT.md.
TEXT_WHISPERER_URL=http://macbook-pro-14-m4-pro:8090
# Its WEB_PASSWORD, sent as a bearer token. Leave blank only while the service
# is reachable on loopback or a tailnet and nothing else.
TEXT_WHISPERER_TOKEN=
# A whole job, not a connect timeout: Whisper on a long recording is slow.
TEXT_WHISPERER_TIMEOUT=300
# ISO code (en, zh, ms, ta, ...) to force a language; blank = auto-detect.
TEXT_WHISPERER_LANGUAGE=
# Set false for a self-signed cert.
TEXT_WHISPERER_SSL_VERIFY=true

# --- Core / Controller -----------------------------------------------------
ALENA_CONTROLLER_URL=http://localhost:9000
ALENA_MAX_TOOL_STEPS=3
ALENA_MEMORY_MAX_MESSAGES=20

# --- Voice Assistant Backend -----------------------------------------------
APP_NAME=voice-assistant-backend
LOG_LEVEL=INFO
MAX_AUDIO_BYTES=25000000

# CORS (JSON array format required by pydantic-settings)
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8001"]

# Timeout (seconds) for requests to the controller
ALENA_CONTROLLER_TIMEOUT=120

# Where a transcript goes next:
#   alena    -> the controller, which can call tools (the useful one)
#   lmstudio -> straight to the model, no tools
LLM_ROUTE=alena

# Allow the backend to proxy /v1/chat/completions for the web UI.
LLM_ENABLED=true

# Backend server bind address and port
HOST=localhost
PORT=8001

# --- Voice Assistant Frontend ----------------------------------------------
# The browser talks only to the backend; it never reaches LM Studio directly.
NUXT_PUBLIC_LLM_API_URL=http://localhost:8001
NUXT_PUBLIC_WS_AUDIO_URL=ws://localhost:8000/ws

# --- Telegram Bot ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_TARGET_CHAT_ID=-1001234567890
TELEGRAM_SOURCE_CHAT_IDS=
TELEGRAM_ECHO_IN_TARGET=false
TELEGRAM_REPLY_IN_SOURCE=false

TELEGRAM_CONTROLLER_ENABLED=true
TELEGRAM_CONTROLLER_URL=http://localhost:9000
TELEGRAM_CONTROLLER_TIMEOUT=120
TELEGRAM_CONTROLLER_MAX_CONCURRENCY=2

# Voice memos use the TEXT_WHISPERER_* settings above.

# --- Google Calendar MCP ---------------------------------------------------
# Path to Google OAuth credentials JSON file
# Download from: https://console.cloud.google.com/ (OAuth 2.0 Desktop Application)
GOOGLE_CREDENTIALS_PATH=./modules/mcp/google-calendar/secrets/credentials.json
GOOGLE_TOKEN_PATH=./modules/mcp/google-calendar/secrets/token.json

# Default calendar ID (use "primary" for your main calendar)
CALENDAR_ID=primary

# Optional: Custom timezone for calendar operations (IANA timezone format)
# Examples: UTC, America/New_York, Europe/London, Asia/Tokyo
CALENDAR_TIMEZONE=UTC
# Offset applied to naive datetimes the model produces for calendar tools.
CALENDAR_TIMEZONE_OFFSET=+08:00

# --- Tool Gateway ----------------------------------------------------------
# Every tool call goes through the gateway: the policy decides, the audit log
# records. Set to 0 only to work around a gateway misconfiguration -- it
# bypasses every policy check.
ALENA_GATEWAY_ENABLED=1
# Tool policy. Relative paths resolve against the repo root.
ALENA_TOOL_POLICY=config/tool_policy.yaml
# Audit log and orchestrator state. Kept outside the repo on purpose.
ALENA_DB_PATH=~/.alena/alena.db
# Store a redacted copy of call arguments alongside the hash. Off by default:
# arguments routinely carry file contents and can carry credentials.
ALENA_AUDIT_ARGUMENTS=0
# Comma-separated roots that repo_path arguments must stay inside. Empty means
# unchecked. Superseded by the repository registry in Phase 1.
ALENA_ALLOWED_REPO_ROOTS=

# --- Improvement orchestrator (alena-improve) ------------------------------
# Which repositories may be analysed, and what may be done to them.
ALENA_REPOSITORIES=config/repositories.yaml
# If set, every declared workspace must sit inside this root. Worth setting:
# the registry's workspaces become the gateway's allowed paths.
ALENA_WORKSPACE_ROOT=
# Generated profiles, research, reviews and recommendations. Outside the repo:
# it grows on every run.
ALENA_INTELLIGENCE_DIR=~/.alena/intelligence
# LM Studio loads embedding models in a separate slot from chat models. Name
# the embedding model here; blank uses whatever is loaded in that slot.
LLM_EMBEDDING_MODEL=

# --- Claude Code routine (independent engineering review) ------------------
# The HTTP trigger for a Claude Code Routine. ALENA posts a review prompt and
# reads the answer; it is the one agent ALENA initiates rather than consumes.
# Unset means `review --agent claude` reports that it has nowhere to send.
CLAUDE_ROUTINE_URL=
CLAUDE_ROUTINE_TOKEN=
CLAUDE_ROUTINE_TIMEOUT=300
CLAUDE_ROUTINE_POLL_INTERVAL=5

# --- Improvement dashboard -------------------------------------------------
# scripts/start_alena_dashboard.sh runs the API on 9100 and Nuxt on 3100, both
# on loopback. The API approves recommendations, so keep it there.
ALENA_DASHBOARD_HOST=127.0.0.1
ALENA_DASHBOARD_PORT=9100
ALENA_DASHBOARD_ORIGINS=

# --- Display timezone ------------------------------------------------------
# Storage stays UTC. This is only how timestamps are displayed, in the CLI,
# the generated reports and the dashboard.
ALENA_TIMEZONE=Asia/Singapore

# --- Research drop directory -----------------------------------------------
# ~/alena-research/<repository-id>/*.md — a cycle ingests what it finds there.
ALENA_RESEARCH_DIR=~/alena-research
